# AI Interview Platform - Environment Configuration

# Hugging Face Configuration
HF_API_TOKEN=your_huggingface_api_token_here
HF_MODEL_ID=mistralai/Mistral-7B-Instruct-v0.2

# Security & Authentication
JWT_SECRET=temporary_development_secret_key_please_change_in_production_987654321
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database & Vector Store
SQLITE_DB_PATH=ai_interview.db
CHROMA_PERSIST_PATH=./chroma_data

# Question Bank Source (Fallback to local bundled data/questions.json)
GITHUB_QUESTIONS_URL=https://raw.githubusercontent.com/DopplerHQ/awesome-interview-questions/master/README.md

# Server settings
HOST=127.0.0.1
PORT=8000
DEBUG=True
